{
  "name": "zyphorix-enterprise",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "prisma migrate deploy",
    "docker:dev": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:build": "docker build -f docker/Dockerfile -t zyphorix-guard:latest .",
    "analyze": "ANALYZE=true next build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@aws-sdk/client-ec2": "^3.1106.0",
    "@aws-sdk/client-iam": "^3.1106.0",
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/client-sts": "^3.1106.0",
    "@aws-sdk/credential-providers": "^3.1106.0",
    "@hookform/resolvers": "^5.0.1",
    "@prisma/client": "^6.8.2",
    "@sentry/nextjs": "^10.70.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.75.5",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.9",
    "autoprefixer": "^10.5.4",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.9.4",
    "lucide-react": "^0.513.0",
    "next": "^16.2.10",
    "next-auth": "^5.0.0-beta.28",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.4",
    "recharts": "^2.15.3",
    "resend": "^4.5.1",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.3.3",
    "zod": "^3.24.4",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitest/coverage-v8": "^4.1.10",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}